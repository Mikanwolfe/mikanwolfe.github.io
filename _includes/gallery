<!-- Gallery file from https://github.com/TaylanTatli/Moon -->

{% assign images = include.images | split:" " %}
{% assign caption = include.caption %}
{% assign cols = include.cols %}

{% case cols %}
    {% when 1 %}
        {% assign class = "" %}
    {% when 2 %}
        {% assign class = "half" %}
    {% when 3 %}
        {% assign class = "third" %}
    {% else %}
        {% assign class = "" %}
{% endcase %}

<figure {% if class != "" %}class="{{ class }}"{% endif %}>
    {% for image in images %}
    <a href="{{ image }}" title="{{caption}}"><img src="{{ image }}" alt="{{caption}}"></a>
    {% endfor %}
    <figcaption>{{ caption }}</figcaption>
</figure>
